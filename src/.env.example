OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# Ollama 사용 시 (LLM_PROVIDER=ollama 로 변경)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/poc.db

# DP3 Cache PoC: true면 외부 LLM 호출 없이 mock 답변 반환
DP3_MOCK_LLM=true

# DP3 Cache PoC LLM provider. 비워두면 DP3_MOCK_LLM 값을 따른다.
# Options: mock, groq, default
DP3_LLM_PROVIDER=mock
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
